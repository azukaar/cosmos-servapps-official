{
  "cosmos-installer": {
    "form": [
      {
        "name": "authSecret",
        "label": "Session secret (required - it signs the login sessions; generate one with: openssl rand -base64 32)",
        "initialValue": "",
        "type": "password"
      },
      {
        "name": "demo",
        "label": "Seed the demo data set? It shows demo logins with known passwords - leave this off unless nobody else can reach this machine.",
        "initialValue": false,
        "type": "checkbox"
      }
    ]
  },
  "minVersion": "0.13.0",
  "services": {
    "{ServiceName}": {
      "image": "ghcr.io/fgilde/coworkeenextjs:latest",
      "container_name": "{ServiceName}",
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "start_period": 30
      },
      "depends_on": ["{ServiceName}-postgres"],
      "environment": [
        "TZ=auto",
        "DATABASE_URL=postgresql://coworkee:{Passwords.0}@{ServiceName}-postgres:5432/coworkee?schema=public",
        "AUTH_SECRET={Context.authSecret}",
        "AUTH_TRUST_HOST=true"
        {if Context.demo}
        , "DEMO=1"
        {/if}
      ],
      "labels": {
        "cosmos-persistent-env": "DATABASE_URL, AUTH_SECRET",
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/Coworkee/icon.png",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "networks": {
        "{ServiceName}-postgres": {}
      },
      "volumes": [
        {
          "source": "{ServiceName}-storage",
          "target": "/app/storage",
          "type": "volume"
        }
      ],
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose {ServiceName} to the web",
          "useHost": true,
          "target": "http://{ServiceName}:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          },
          "AuthEnabled": true
        }
      ]
    },
    "{ServiceName}-postgres": {
      "image": "postgres:16-alpine",
      "container_name": "{ServiceName}-postgres",
      "hostname": "{ServiceName}-postgres",
      "restart": "unless-stopped",
      "networks": {
        "{ServiceName}-postgres": {}
      },
      "environment": [
        "POSTGRES_DB=coworkee",
        "POSTGRES_USER=coworkee",
        "POSTGRES_PASSWORD={Passwords.0}"
      ],
      "labels": {
        "cosmos-persistent-env": "POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "volumes": [
        {
          "source": "{ServiceName}-postgres-data",
          "target": "/var/lib/postgresql/data",
          "type": "volume"
        }
      ]
    }
  },
  "networks": {
    "{ServiceName}-postgres": {}
  }
}
