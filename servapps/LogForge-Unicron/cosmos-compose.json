{
  "cosmos-installer": {
    "form": [
      {
        "name": "adminUsername",
        "label": "Initial administrator username",
        "initialValue": "admin",
        "type": "text"
      },
      {
        "name": "adminPassword",
        "label": "Initial administrator password (uppercase, lowercase, numeric, and special characters required)",
        "initialValue": "",
        "type": "password"
      },
      {
        "name": "agentPort",
        "label": "Host port for agent mTLS connections",
        "initialValue": "9443",
        "type": "text"
      },
      {
        "name": "adminOnly",
        "label": "Restrict the web route to Cosmos administrators?",
        "initialValue": false,
        "type": "checkbox"
      }
    ],
    "post-install": [
      {
        "type": "info",
        "label": "Security notice: agents with writable Docker socket access have root-equivalent control of their Docker hosts. Only enroll hosts you trust and restrict LogForge administrator access. This Central appliance has no Docker socket access."
      },
      {
        "type": "info",
        "label": "Open /unicron on the configured Cosmos URL. Add a remote agent in Settings using a Central address reachable from the agent host and the configured mTLS port. Pull logforge/unicron-agent:latest on that host before running the generated enrollment command. This also applies when manually enrolling the Cosmos host."
      },
      {
        "type": "info",
        "label": "Manage appliance updates through Cosmos. In-app self-update and automatic local agent deployment are disabled by the absence of Docker socket access; enroll agents manually. The Central appliance does not monitor the Cosmos host until an agent is enrolled."
      }
    ]
  },
  "minVersion": "0.8.0",
  "services": {
    "{ServiceName}": {
      "image": "logforge/unicron:3.0.0",
      "container_name": "{ServiceName}",
      "restart": "unless-stopped",
      "uid": 0,
      "gid": 0,
      "cap_drop": ["ALL"],
      "cap_add": ["CHOWN", "DAC_OVERRIDE", "FOWNER", "KILL", "SETGID", "SETUID", "NET_BIND_SERVICE"],
      "security_opt": ["no-new-privileges:true"],
      "environment": [
        "TMPDIR=/run/pyinstaller",
        "UNICRON_APPLIANCE_CONTAINER_NAME={ServiceName}",
        "UNICRON_SELF_UPDATE_ENABLED=false",
        "REMOTE_AGENT_IMAGE=logforge/unicron-agent:latest",
        "UNICRON_CENTRAL_FQDN=localhost",
        "UNICRON_CENTRAL_PORT=443",
        "UNICRON_PUBLIC_CENTRAL_PORT=443",
        "UNICRON_CENTRAL_MTLS_PORT=8443",
        "UNICRON_PUBLIC_CENTRAL_MTLS_PORT={Context.agentPort}",
        "UNICRON_DATA_DIR=/var/lib/unicron",
        "CENTRAL_ADMIN_USERNAME={Context.adminUsername}",
        "CENTRAL_ADMIN_PASSWORD={Context.adminPassword}",
        "CENTRAL_ADMIN_RECOVERY_OVERRIDE=false"
      ],
      "extra_hosts": [
        "unicron-stepca:127.0.0.1",
        "unicron-stepca-ra:127.0.0.1",
        "unicron.central:127.0.0.1"
      ],
      "ports": ["{Context.agentPort}:8443"],
      "healthcheck": {
        "test": ["CMD", "/usr/local/bin/unicron-appliance-manager", "healthcheck"],
        "interval": 30,
        "timeout": 10,
        "start_period": 120,
        "retries": 3
      },
      "volumes": [
        {
          "source": "{ServiceName}-data",
          "target": "/var/lib/unicron",
          "type": "volume"
        },
        {
          "target": "/tmp",
          "type": "tmpfs",
          "TmpfsOptions": {"SizeBytes": 268435456, "Mode": 1023}
        },
        {
          "target": "/run",
          "type": "tmpfs",
          "TmpfsOptions": {"SizeBytes": 67108864, "Mode": 493}
        },
        {
          "source": "{ServiceName}-pyinstaller",
          "target": "/run/pyinstaller",
          "type": "volume"
        }
      ],
      "labels": {
        "cosmos-force-network-secured": "true",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/LogForge-Unicron/icon.png",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose LogForge Unicron to the web",
          "useHost": true,
          "target": "https://{ServiceName}:443",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {"Enabled": true},
          "AcceptInsecureHTTPSTarget": true,
          "AuthEnabled": true
          {if Context.adminOnly}
            , "AuthAdmin": true
          {/if}
        }
      ]
    }
  }
}
