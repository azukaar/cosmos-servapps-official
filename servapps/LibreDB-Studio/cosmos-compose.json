{
    "cosmos-installer": {},
    "minVersion": "0.11.0",
    "services": {
        "{ServiceName}": {
            "image": "ghcr.io/libredb/libredb-studio:latest",
              "healthcheck": {
                "test": [
                  "CMD",
                  "node",
                  "-e",
                  "require('http').get('http://localhost:80/',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
                ],
                "interval": 30,
                "timeout": 5,
                "start_period": 30,
                "retries": 3
              },
            "container_name": "{ServiceName}",
            "restart": "unless-stopped",
            "environment": [
                "ADMIN_EMAIL=admin@libredb.org",
                "ADMIN_PASSWORD={Passwords.2}",
                "USER_EMAIL=user@libredb.org",
                "USER_PASSWORD={Passwords.3}",
                "JWT_SECRET={Passwords.0}{Passwords.1}",
                "STORAGE_PROVIDER=sqlite",
                "STORAGE_SQLITE_PATH=/app/data/libredb-storage.db"
            ],
            "labels": {
                "cosmos-force-network-secured": "true",
                "cosmos-auto-update": "true",
                "cosmos-icon": "https://raw.githubusercontent.com/azukaar/cosmos-servapps-official/master/servapps/LibreDB-Studio/icon.png"
            },
            "volumes": [{
                "source": "{ServiceName}-libredb-data",
                "target": "/app/data",
                "type": "volume"
            }],
            "routes": [{
                "name": "{ServiceName}",
                "description": "Expose {ServiceName} to the web",
                "useHost": true,
                "target": "http://{ServiceName}:3000",
                "mode": "SERVAPP",
                "Timeout": 14400000,
                "ThrottlePerMinute": 12000,
                "BlockCommonBots": true,
                "SmartShield": {
                    "Enabled": true
                }
            }]
        }
    }
}
