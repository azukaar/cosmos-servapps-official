{
  "cosmos-installer": {
    "form": [
      {
        "name": "adminLogin",
        "label": "Login for the oboku admin panel",
        "initialValue": "admin",
        "type": "text"
      },
      {
        "name": "adminPassword",
        "label": "Password for the oboku admin panel",
        "initialValue": "{Passwords.2}",
        "type": "password"
      }
    ],
    "post-install": [
      {
        "type": "info",
        "label": "The admin panel is the {ServiceName}-admin URL. Cosmos asks for an admin sign-in first, then the panel asks for the oboku admin login above. Without an email provider, readers can only create an account from a sign-up link that the panel generates."
      },
      {
        "type": "warning",
        "label": "oboku only exposes the options its installer needs. Email sign-up, cloud sync providers (Dropbox, Google Drive, OneDrive) and the performance settings are configured through extra environment variables: https://docs.oboku.me/self-hosting/configuration"
      }
    ]
  },
  "minVersion": "0.16.0",
  "services": {
    "{ServiceName}": {
      "image": "mbret/oboku-web",
      "container_name": "{ServiceName}",
      "restart": "unless-stopped",
      "depends_on": {
        "{ServiceName}-api": {}
      },
      "environment": [
        "VITE_API_URL=https://{Hostnames.{StaticServiceName}-api.{StaticServiceName}-api.host}"
      ],
      "healthcheck": {
        "test": ["CMD", "wget", "-q", "--spider", "http://127.0.0.1/"],
        "interval": 30,
        "timeout": 5,
        "retries": 3
      },
      "labels": {
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/Oboku/icon.png",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose {ServiceName} to the web",
          "useHost": true,
          "target": "http://{ServiceName}:80",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          },
          "AuthEnabled": false
        }
      ]
    },

    "{ServiceName}-admin": {
      "image": "mbret/oboku-admin",
      "container_name": "{ServiceName}-admin",
      "restart": "unless-stopped",
      "depends_on": {
        "{ServiceName}-api": {}
      },
      "environment": [
        "VITE_API_URL=https://{Hostnames.{StaticServiceName}-api.{StaticServiceName}-api.host}"
      ],
      "healthcheck": {
        "test": ["CMD", "wget", "-q", "--spider", "http://127.0.0.1/"],
        "interval": 30,
        "timeout": 5,
        "retries": 3
      },
      "labels": {
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/Oboku/icon.png",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "routes": [
        {
          "name": "{ServiceName}-admin",
          "description": "Expose the {ServiceName} admin panel to Cosmos admins",
          "useHost": true,
          "target": "http://{ServiceName}-admin:80",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          },
          "AuthEnabled": true,
          "AdminOnly": true
        }
      ]
    },

    "{ServiceName}-api": {
      "image": "mbret/oboku-api",
      "container_name": "{ServiceName}-api",
      "restart": "unless-stopped",
      "depends_on": {
        "{ServiceName}-couchdb": {
          "condition": "service_healthy"
        },
        "{ServiceName}-postgres": {
          "condition": "service_healthy"
        }
      },
      "environment": [
        "APP_PUBLIC_URL=https://{Hostnames.{StaticServiceName}.{StaticServiceName}.host}",
        "ADMIN_PUBLIC_URL=https://{Hostnames.{StaticServiceName}-admin.{StaticServiceName}-admin.host}",
        "COUCH_DB_URL=http://{ServiceName}-couchdb:5984",
        "POSTGRES_HOST={ServiceName}-postgres",
        "POSTGRES_DB=oboku",
        "POSTGRES_USER=oboku",
        "POSTGRES_PASSWORD={Passwords.0}",
        "ADMIN_LOGIN={Context.adminLogin}",
        "ADMIN_PASSWORD={Context.adminPassword}",
        "API_DATA_DIR=/var/lib/oboku/data",
        "API_CONFIG_DIR=/var/lib/oboku/config"
      ],
      "volumes": [
        {
          "source": "{ServiceName}-secrets",
          "target": "/secrets",
          "type": "volume"
        },
        {
          "source": "{ServiceName}-api-data",
          "target": "/var/lib/oboku/data",
          "type": "volume"
        },
        {
          "source": "{ServiceName}-api-config",
          "target": "/var/lib/oboku/config",
          "type": "volume"
        }
      ],
      "healthcheck": {
        "test": ["CMD", "curl", "-f", "http://localhost:3000/web/config"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "start_period": 30
      },
      "labels": {
        "cosmos-persistent-env": "ADMIN_LOGIN, ADMIN_PASSWORD, POSTGRES_PASSWORD",
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/Oboku/icon.png",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "routes": [
        {
          "name": "{ServiceName}-api",
          "description": "Expose {ServiceName}-api to the web",
          "useHost": true,
          "target": "http://{ServiceName}-api:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          },
          "AuthEnabled": false,
          "DisableHeaderHardening": true
        }
      ]
    },

    "{ServiceName}-couchdb": {
      "image": "mbret/oboku-couchdb",
      "container_name": "{ServiceName}-couchdb",
      "restart": "unless-stopped",
      "environment": [
        "COUCHDB_USER=admin",
        "COUCHDB_PASSWORD={Passwords.1}"
      ],
      "volumes": [
        {
          "source": "{ServiceName}-secrets",
          "target": "/secrets",
          "type": "volume"
        },
        {
          "source": "{ServiceName}-couchdb-data",
          "target": "/opt/couchdb/data",
          "type": "volume"
        },
        {
          "source": "{ServiceName}-couchdb-config",
          "target": "/opt/couchdb/etc/local.d",
          "type": "volume"
        }
      ],
      "healthcheck": {
        "test": ["CMD", "curl", "-f", "http://localhost:5984/_up"],
        "interval": 10,
        "timeout": 5,
        "retries": 10,
        "start_period": 20
      },
      "labels": {
        "cosmos-persistent-env": "COUCHDB_PASSWORD, COUCHDB_USER",
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/Oboku/icon.png",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      }
    },

    "{ServiceName}-postgres": {
      "image": "postgres:17-trixie",
      "container_name": "{ServiceName}-postgres",
      "restart": "unless-stopped",
      "environment": [
        "POSTGRES_DB=oboku",
        "POSTGRES_USER=oboku",
        "POSTGRES_PASSWORD={Passwords.0}"
      ],
      "volumes": [
        {
          "source": "{ServiceName}-postgres-data",
          "target": "/var/lib/postgresql/data",
          "type": "volume"
        }
      ],
      "healthcheck": {
        "test": ["CMD", "pg_isready", "-U", "oboku", "-d", "oboku"],
        "interval": 10,
        "timeout": 5,
        "retries": 10
      },
      "labels": {
        "cosmos-persistent-env": "POSTGRES_DB, POSTGRES_PASSWORD, POSTGRES_USER",
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/Oboku/icon.png",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      }
    }
  }
}
