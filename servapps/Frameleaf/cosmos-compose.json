{
  "cosmos-installer": {
    "form": [
      {
        "name": "betaNotice",
        "label": "Frameleaf is in beta. It needs about 6 GB of RAM and 2 CPU cores. The database is kept in a local Docker volume; do not move it to a network share.",
        "type": "warning"
      },
      {
        "name": "photoPath",
        "label": "Where should Frameleaf keep your library (originals, thumbnails and encoded video)?",
        "initialValue": "{DefaultDataPath}/frameleaf-library",
        "type": "text"
      }
    ],
    "post-install": [
      {
        "type": "success",
        "name": "firstRun",
        "label": "Open Frameleaf at the URL you chose. The first visit asks you to create the admin account (there are no default credentials). The first start can take a few minutes while the database initialises."
      },
      {
        "type": "info",
        "name": "dbPassword",
        "label": "Database password (generated for this install, keep it for backups and restores): {Passwords.0}"
      }
    ]
  },
  "minVersion": "0.12.0",
  "services": {
    "{ServiceName}": {
      "container_name": "{ServiceName}",
      "hostname": "{ServiceName}",
      "image": "ghcr.io/frameleaf/frameleaf-server:frameleaf-v1.2.3",
      "volumes": [
        {
          "source": "{Context.photoPath}",
          "target": "/data",
          "type": "bind"
        },
        {
          "source": "/etc/localtime",
          "target": "/etc/localtime",
          "type": "bind",
          "readOnly": true
        },
        {
          "source": "{ServiceName}-studio-worker",
          "target": "/run/frameleaf/studio-worker",
          "type": "volume"
        }
      ],
      "labels": {
        "cosmos-persistent-env": "DB_HOSTNAME, DB_USERNAME, DB_PASSWORD, DB_DATABASE_NAME, FRAMELEAF_MACHINE_LEARNING_URL",
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "false",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/Frameleaf/icon.png",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "environment": [
        "DB_HOSTNAME={ServiceName}-database",
        "DB_USERNAME=postgres",
        "DB_PASSWORD={Passwords.0}",
        "DB_DATABASE_NAME=frameleaf",
        "FRAMELEAF_MACHINE_LEARNING_URL=http://{ServiceName}-machine-learning:3003"
      ],
      "depends_on": {
        "{ServiceName}-database": {
          "condition": "service_healthy"
        }
      },
      "shm_size": "2gb",
      "stop_grace_period": 10,
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose {ServiceName} to the web",
          "useHost": true,
          "target": "http://{ServiceName}:2283",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true,
            "PolicyStrictness": 3,
            "PerUserRequestLimit": 12000,
            "PerUserSimultaneous": 100,
            "MaxGlobalSimultaneous": 1000
          }
        }
      ],
      "restart": "always"
    },
    "{ServiceName}-machine-learning": {
      "container_name": "{ServiceName}-machine-learning",
      "hostname": "{ServiceName}-machine-learning",
      "image": "ghcr.io/frameleaf/frameleaf-machine-learning:frameleaf-v1.2.3",
      "volumes": [
        {
          "source": "{ServiceName}-model-cache",
          "target": "/cache",
          "type": "volume"
        },
        {
          "source": "{ServiceName}-studio-worker",
          "target": "/run/frameleaf/studio-worker",
          "type": "volume",
          "readOnly": true
        }
      ],
      "labels": {
        "cosmos-persistent-env": "FRAMELEAF_STUDIO_WORKER_SERVER_URL",
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "false",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/Frameleaf/icon.png",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "environment": [
        "FRAMELEAF_STUDIO_WORKER_SERVER_URL=http://{ServiceName}:2283"
      ],
      "restart": "always"
    },
    "{ServiceName}-database": {
      "container_name": "{ServiceName}-database",
      "hostname": "{ServiceName}-database",
      "image": "ghcr.io/frameleaf/frameleaf-postgres:19beta4-pgvector0.8.7@sha256:7b155ed85302ab66c1022309f1f70f0b79f98f70bd52af8d7d3611a0cbf08cf0",
      "labels": {
        "cosmos-persistent-env": "POSTGRES_PASSWORD, POSTGRES_USER, POSTGRES_DB",
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "false",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/Frameleaf/icon.png",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "environment": [
        "POSTGRES_PASSWORD={Passwords.0}",
        "POSTGRES_USER=postgres",
        "POSTGRES_DB=frameleaf",
        "POSTGRES_INITDB_ARGS=--data-checksums"
      ],
      "volumes": [
        {
          "source": "{ServiceName}-pgdata",
          "target": "/var/lib/postgresql",
          "type": "volume"
        }
      ],
      "shm_size": "128mb",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready --host=127.0.0.1 --dbname=\"$POSTGRES_DB\" --username=\"$POSTGRES_USER\" && /usr/local/bin/healthcheck.sh"
        ],
        "interval": 30,
        "start_period": 300
      },
      "restart": "always"
    }
  }
}
