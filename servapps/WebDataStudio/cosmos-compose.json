{
  "cosmos-installer": {
    "form": [
      {
        "name": "adminUser",
        "label": "Admin user name (required - without it the studio serves with no login screen at all)",
        "initialValue": "",
        "type": "text"
      },
      {
        "name": "adminPassword",
        "label": "Admin password (required - without it the studio serves with no login screen at all)",
        "initialValue": "",
        "type": "password"
      }
    ]
  },
  "minVersion": "0.13.0",
  "services": {
    "{ServiceName}": {
      "image": "ghcr.io/fgilde/webdatastudio:latest",
      "container_name": "{ServiceName}",
      "restart": "unless-stopped",
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -fsS http://127.0.0.1:8080/api/health -o /dev/null || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "start_period": 30
      },
      "environment": [
        "TZ=auto",
        "WDS_USER={Context.adminUser}",
        "WDS_PASSWORD={Context.adminPassword}"
      ],
      "labels": {
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/WebDataStudio/icon.png"
      },
      "volumes": [
        {
          "source": "{ServiceName}-data",
          "target": "/data",
          "type": "volume"
        }
      ],
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose {ServiceName} to the web",
          "useHost": true,
          "target": "http://{ServiceName}:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          },
          "AuthEnabled": true,
          "AuthAdmin": true
        }
      ]
    }
  }
}
