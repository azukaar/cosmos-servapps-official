{
  "cosmos-installer": {
    "post-install": [
      {
        "type": "info",
        "label": "Sign in with your Cosmos account — the first person to sign in becomes the Keeyo admin."
      }
    ]
  },
  "minVersion": "0.22.29",
  "services": {
    "{ServiceName}": {
      "image": "ghcr.io/ans-ib/keeyo:2.1.0",
      "container_name": "{ServiceName}",
      "restart": "unless-stopped",
      "environment": [
        "TRUST_PROXY=1",
        "KEEYO_OIDC_ISSUER={RootProtocol}://{RootHostname}",
        "KEEYO_OIDC_CLIENT_ID=__route_{ServiceName}",
        "KEEYO_OIDC_NAME=Cosmos",
        "KEEYO_OIDC_ADMIN_BOOTSTRAP=1"
      ],
      "volumes": [
        {
          "source": "{ServiceName}-data",
          "target": "/data",
          "type": "volume"
        }
      ],
      "labels": {
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/Keeyo/icon.png"
      },
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose {ServiceName} to the web",
          "publicOpenIDName": "__route_{ServiceName}",
          "useHost": true,
          "target": "http://{ServiceName}:5390",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          }
        }
      ]
    }
  }
}
