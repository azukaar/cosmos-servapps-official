{
  "cosmos-installer": {
    "post-install": [
      {
        "type": "success",
        "name": "firstAccount",
        "label": "Open Ferret and sign up: the first account runs the server. Then make a key file for its keys (Settings → Server → Keys) and keep it somewhere else."
      }
    ]
  },
  "minVersion": "0.22.23",
  "services": {
    "{ServiceName}": {
      "image": "ferretproject/ferret:2026.11.4",
      "container_name": "{ServiceName}",
      "restart": "unless-stopped",
      "environment": [
        "PUBLIC_URL={RootProtocol}://{Hostnames.{ServiceName}.{ServiceName}.host}",
        "TRUSTED_PROXIES=172.16.0.0/12"
      ],
      "labels": {
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/Ferret/icon.png"
      },
      "volumes": [
        {
          "source": "{ServiceName}-data",
          "target": "/data",
          "type": "volume"
        }
      ],
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose {ServiceName} to the web",
          "useHost": true,
          "target": "http://{ServiceName}:8787",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          }
        }
      ]
    }
  }
}
