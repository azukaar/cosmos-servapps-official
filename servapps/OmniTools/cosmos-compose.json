{
    "cosmos-installer": {},
    "minVersion": "0.9.0",
    "services": {
        "{ServiceName}": {
            "image": "iib0011/omni-tools:latest",
              "healthcheck": {
                "test": [
                  "CMD",
                  "/bin/curl",
                  "-fsS",
                  "http://localhost:80/"
                ],
                "interval": 30,
                "timeout": 5,
                "start_period": 20,
                "retries": 3
              },
            "container_name": "{ServiceName}",
            "restart": "unless-stopped",
            "labels": {
                "cosmos-force-network-secured": "true",
                "cosmos-auto-update": "true",
                "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/OmniTools/icon.png"
            },
            "routes": [{
                "name": "{ServiceName}",
                "description": "Expose {ServiceName} to the web",
                "useHost": true,
                "target": "http://{ServiceName}:80",
                "mode": "SERVAPP",
                "Timeout": 14400000,
                "ThrottlePerMinute": 12000,
                "BlockCommonBots": true,
                "SmartShield": {
                    "Enabled": true
                }
            }]
        }
    }
}
