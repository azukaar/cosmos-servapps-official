{
  "cosmos-installer": {
    "form": [
      {
        "name": "authSecret",
        "label": "Session secret (required - it signs the login sessions; generate one with: openssl rand -base64 32)",
        "initialValue": "",
        "type": "password"
      },
      {
        "name": "seedDemo",
        "label": "Type true to install the demo data set with the admin account admin@havewa.app / admin, or leave empty for the setup wizard",
        "initialValue": "",
        "type": "text"
      }
    ]
  },
  "minVersion": "0.13.0",
  "services": {
    "{ServiceName}": {
      "image": "ghcr.io/fgilde/hausverwaltung:latest",
      "container_name": "{ServiceName}",
      "restart": "unless-stopped",
      "depends_on": ["{ServiceName}-postgres"],
      "environment": [
        "TZ=auto",
        "DATABASE_URL=postgresql://havewa:{Passwords.0}@{ServiceName}-postgres:5432/havewa?schema=public",
        "AUTH_SECRET={Context.authSecret}",
        "AUTH_TRUST_HOST=true",
        "SEED_DEMO={Context.seedDemo}"
      ],
      "labels": {
        "cosmos-persistent-env": "DATABASE_URL, AUTH_SECRET",
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/HaVeWa/icon.png",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "networks": {
        "{ServiceName}-postgres": {}
      },
      "volumes": [
        {
          "source": "{ServiceName}-storage",
          "target": "/app/storage",
          "type": "volume"
        }
      ],
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose {ServiceName} to the web",
          "useHost": true,
          "target": "http://{ServiceName}:3000",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          }
        }
      ]
    },
    "{ServiceName}-postgres": {
      "image": "postgres:16-alpine",
      "container_name": "{ServiceName}-postgres",
      "hostname": "{ServiceName}-postgres",
      "restart": "unless-stopped",
      "networks": {
        "{ServiceName}-postgres": {}
      },
      "environment": [
        "POSTGRES_DB=havewa",
        "POSTGRES_USER=havewa",
        "POSTGRES_PASSWORD={Passwords.0}"
      ],
      "labels": {
        "cosmos-persistent-env": "POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "volumes": [
        {
          "source": "{ServiceName}-postgres-data",
          "target": "/var/lib/postgresql/data",
          "type": "volume"
        }
      ]
    }
  },
  "networks": {
    "{ServiceName}-postgres": {}
  }
}
