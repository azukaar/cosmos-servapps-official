{
  "cosmos-installer": {},

  "minVersion": "0.13.0",
  
  "services": {
    "{ServiceName}": {
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import sys,http.client\ntry:\n    c = http.client.HTTPConnection('127.0.0.1', 8080, timeout=3)\n    c.request('GET', '/api/health')\n    sys.exit(0 if c.getresponse().status == 200 else 1)\nexcept Exception:\n    sys.exit(1)"
        ],
        "interval": 30,
        "timeout": 5,
        "start_period": 20,
        "retries": 3
      },
      "image": "drumsergio/cashpilot:latest",
      "container_name": "{ServiceName}",
      "restart": "unless-stopped",
      "environment": [
        "TZ=auto",
        "SUPPORTED_APPS=earnapp,honeygain,iproyal,peer2profit,repocket,traffmonetizer,proxyrack,packetstream,grass,nodepay",
        "LOG_LEVEL=info",
        "WORKER_URL=http://{ServiceName}-worker:8081"
      ],
      "labels": {
        "cosmos-persistent-env": "SUPPORTED_APPS, LOG_LEVEL, WORKER_URL",
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/CashPilot/icon.png",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose {ServiceName} to the web",
          "useHost": true,
          "target": "http://{ServiceName}:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          }
        }
      ]
    },
    "{ServiceName}-worker": {
      "image": "drumsergio/cashpilot-worker:latest",
      "container_name": "{ServiceName}-worker",
      "restart": "unless-stopped",
      "environment": [
        "TZ=auto"
      ],
      "volumes": [
        {
          "source": "/var/run/docker.sock",
          "target": "/var/run/docker.sock",
          "type": "bind"
        }
      ],
      "labels": {
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      }
    }
  }
}
