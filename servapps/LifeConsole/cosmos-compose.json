{
  "cosmos-installer": {
    "post-install": [
      {
        "type": "info",
        "label": "Life Console migrates its database on first start, which takes a few seconds. The first account you create becomes the admin; set SIGNUPS=off afterwards to stop others signing up."
      }
    ]
  },
  "minVersion": "0.9.0",
  "services": {
    "{ServiceName}": {
      "image": "ghcr.io/tj-coding/life-console:0.1",
      "container_name": "{ServiceName}",
      "restart": "unless-stopped",
      "environment": [
        "DATABASE_URL=postgres://lifeconsole:{Passwords.0}@{ServiceName}-postgres:5432/lifeconsole",
        "TRUST_PROXY=1",
        "SIGNUPS=open",
        "AUTH_PASSWORD=on",
        "UPDATE_CHECK=off",
        "BACKUP_DIR=/backups"
      ],
      "labels": {
        "cosmos-persistent-env": "DATABASE_URL",
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://azukaar.github.io/cosmos-servapps-official/servapps/LifeConsole/icon.png",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "volumes": [
        {
          "source": "{ServiceName}-backups",
          "target": "/backups",
          "type": "volume"
        }
      ],
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose {ServiceName} to the web",
          "useHost": true,
          "target": "http://{ServiceName}:8080",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          }
        }
      ]
    },
    "{ServiceName}-postgres": {
      "image": "postgres:17-alpine",
      "container_name": "{ServiceName}-postgres",
      "hostname": "{ServiceName}-postgres",
      "restart": "unless-stopped",
      "volumes": [
        {
          "source": "{ServiceName}-postgres-data",
          "target": "/var/lib/postgresql/data",
          "type": "volume"
        }
      ],
      "labels": {
        "cosmos-persistent-env": "POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "environment": [
        "POSTGRES_DB=lifeconsole",
        "POSTGRES_USER=lifeconsole",
        "POSTGRES_PASSWORD={Passwords.0}"
      ]
    }
  }
}
